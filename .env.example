# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.

# Warehouse (Postgres) - owner account used by Spark, dbt and Airflow
POSTGRES_USER=niftyoculus
POSTGRES_PASSWORD=change_me
POSTGRES_DB=niftyoculus
POSTGRES_PORT=5432

# Read-only account used ONLY by the AI analyst (gold schema, SELECT only)
READONLY_USER=niftyoculus_ro
READONLY_PASSWORD=change_me_too

# LLM: get a free key at https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=

# Airflow web login (http://localhost:8080) and session secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_SECRET_KEY=change_me_to_a_long_random_string

# 1 = ingest from data/sample CSV (offline demo), 0 = download from yfinance
NIFTY_USE_SAMPLE=1

# Run Airflow as root so it can write to Windows bind-mounted data/ folder (WSL2 quirk)
AIRFLOW_UID=0

